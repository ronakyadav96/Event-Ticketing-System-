APP_ENV=development            # production disables all in-memory fallbacks
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Node/Express backend (authoritative for events, bookings, payments, refunds)
NODE_BACKEND_BASE_URL=http://localhost:5001
# Must be identical to event-ticketing-backend/.env JWT_SECRET
JWT_SECRET=

# Persistence
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ticketing_ai   # docker compose up -d
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_FALLBACK=true    # development only

# LLM: Claude by default. Model 1 = intent/entities, Model 2 = short replies.
LLM_PROVIDER=anthropic         # anthropic | gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL_INTENT=claude-haiku-4-5
CLAUDE_MODEL_GENERATION=claude-haiku-4-5

# Optional Gemini instead of Claude (LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL_INTENT=gemini-flash-lite-latest
GEMINI_MODEL_GENERATION=gemini-flash-lite-latest

# app = "book X" opens the booking page in the web app; chat = book step by step inside the chat
CHAT_BOOKING_MODE=app

# Must match the Node backend EVENT_TIMEZONE
EVENT_TIMEZONE=Asia/Kolkata

# FAQ retrieval
VECTOR_STORE_PATH=data/vectorstore
EMBEDDING_PROVIDER=auto        # auto | huggingface | builtin
