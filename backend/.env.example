NODE_ENV=development             # production hides internal error messages
PORT=5001

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/event_management
# Must be identical to ai-service/.env JWT_SECRET
JWT_SECRET=

# Browser origins allowed by CORS (comma-separated). The first one is used for Stripe redirects.
CLIENT_URL=http://localhost:4200
# Public URL of this backend (used in email verification links)
SERVER_URL=http://localhost:5001

# Email (OTP verification, password reset, tickets)
EMAIL_OTP_TTL_MINUTES=10
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Event Booking <no-reply@example.com>"
MAIL_DISABLED=false              # true = log emails instead of sending (dev only)

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Movie data
TMDB_API_KEY=
OMDB_API_KEY=
MOVIE_AUTO_REFRESH=true

# First superadmin (npm run seed:admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
