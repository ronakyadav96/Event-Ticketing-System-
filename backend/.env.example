# MongoDB (Atlas or local)
MONGO_URI=
# Must be identical to ai-service/.env JWT_SECRET
JWT_SECRET=
PORT=5001

CLIENT_URL=http://localhost:4200
SERVER_URL=http://localhost:5001
# Wall-clock time zone of show times
EVENT_TIMEZONE=Asia/Kolkata

# Email OTP (set MAIL_DISABLED=true to skip sending in development)
EMAIL_OTP_TTL_MINUTES=10
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_DISABLED=true

# Stripe (test keys for development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Movie posters
TMDB_API_KEY=
OMDB_API_KEY=
